{
  "$defs": {
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "tool_calls": {
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        },
        "model_input_tokens": {
          "minimum": 0,
          "title": "Model Input Tokens",
          "type": "integer"
        },
        "wall_seconds": {
          "minimum": 0,
          "title": "Wall Seconds",
          "type": "integer"
        },
        "replans": {
          "minimum": 0,
          "title": "Replans",
          "type": "integer"
        }
      },
      "required": [
        "tool_calls",
        "model_input_tokens",
        "wall_seconds",
        "replans"
      ],
      "title": "Budget",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "event_seqs": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Event Seqs",
          "type": "array"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "event_seqs",
        "source_refs"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "RouteDecision": {
      "additionalProperties": false,
      "properties": {
        "route_id": {
          "title": "Route Id",
          "type": "string"
        },
        "method": {
          "enum": [
            "rule",
            "classifier",
            "fallback"
          ],
          "title": "Method",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "track": {
          "enum": [
            "sales",
            "servicing",
            "mixed",
            "portfolio"
          ],
          "title": "Track",
          "type": "string"
        },
        "channel": {
          "enum": [
            "phone",
            "chat",
            "secure_message"
          ],
          "title": "Channel",
          "type": "string"
        },
        "language": {
          "enum": [
            "english",
            "spanish",
            "code_switched"
          ],
          "title": "Language",
          "type": "string"
        },
        "depth": {
          "enum": [
            "L1",
            "L2",
            "L3",
            "L4",
            "Q01"
          ],
          "title": "Depth",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "budget": {
          "$ref": "#/$defs/Budget"
        },
        "roles": {
          "items": {
            "type": "string"
          },
          "title": "Roles",
          "type": "array"
        },
        "skills": {
          "items": {
            "type": "string"
          },
          "title": "Skills",
          "type": "array"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "route_id",
        "method",
        "confidence",
        "track",
        "channel",
        "language",
        "depth",
        "path",
        "budget",
        "roles",
        "skills",
        "rationale"
      ],
      "title": "RouteDecision",
      "type": "object"
    },
    "SelectionCandidate": {
      "additionalProperties": false,
      "properties": {
        "interaction_id": {
          "title": "Interaction Id",
          "type": "string"
        },
        "channel": {
          "enum": [
            "phone",
            "chat",
            "secure_message"
          ],
          "title": "Channel",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "features": {
          "additionalProperties": true,
          "title": "Features",
          "type": "object"
        },
        "stratum": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stratum"
        },
        "rank": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rank"
        },
        "selection_reason": {
          "enum": [
            "risk_ranked",
            "random_stratified"
          ],
          "title": "Selection Reason",
          "type": "string"
        }
      },
      "required": [
        "interaction_id",
        "channel",
        "score",
        "features",
        "selection_reason"
      ],
      "title": "SelectionCandidate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "review_id": {
      "title": "Review Id",
      "type": "string"
    },
    "route": {
      "$ref": "#/$defs/RouteDecision"
    },
    "week_start": {
      "title": "Week Start",
      "type": "string"
    },
    "week_end": {
      "title": "Week End",
      "type": "string"
    },
    "capacity": {
      "title": "Capacity",
      "type": "integer"
    },
    "risk_capacity": {
      "title": "Risk Capacity",
      "type": "integer"
    },
    "random_capacity": {
      "title": "Random Capacity",
      "type": "integer"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "population_count": {
      "title": "Population Count",
      "type": "integer"
    },
    "risk_ranked_picks": {
      "items": {
        "type": "string"
      },
      "title": "Risk Ranked Picks",
      "type": "array"
    },
    "random_stratified_picks": {
      "items": {
        "type": "string"
      },
      "title": "Random Stratified Picks",
      "type": "array"
    },
    "selected_reviews": {
      "items": {
        "type": "string"
      },
      "title": "Selected Reviews",
      "type": "array"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/SelectionCandidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "prohibited_features_checked": {
      "items": {
        "type": "string"
      },
      "title": "Prohibited Features Checked",
      "type": "array"
    },
    "field_provenance": {
      "additionalProperties": {
        "$ref": "#/$defs/Provenance"
      },
      "title": "Field Provenance",
      "type": "object"
    }
  },
  "required": [
    "run_id",
    "review_id",
    "route",
    "week_start",
    "week_end",
    "capacity",
    "risk_capacity",
    "random_capacity",
    "seed",
    "population_count",
    "risk_ranked_picks",
    "random_stratified_picks",
    "selected_reviews",
    "candidates",
    "prohibited_features_checked",
    "field_provenance"
  ],
  "title": "SelectionRecord",
  "type": "object"
}
