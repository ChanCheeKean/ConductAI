    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "review_id": {
      "title": "Review Id",
      "type": "string"
    },
    "seq": {
      "exclusiveMinimum": 0,
      "title": "Seq",
      "type": "integer"
    },
    "span_id": {
      "title": "Span Id",
      "type": "string"
    },
    "parent_span_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Span Id"
    },
    "branch_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Branch Id"
    },
    "checkpoint_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checkpoint Id"
    },
    "ts_wall": {
      "format": "date-time",
      "title": "Ts Wall",
      "type": "string"
    },
    "ts_virtual": {
      "format": "date-time",
      "title": "Ts Virtual",
      "type": "string"
    },
    "actor": {
      "$ref": "#/$defs/Actor"
    },
    "type": {
      "$ref": "#/$defs/EventType"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "refs": {
      "items": {
        "type": "string"
      },
      "title": "Refs",
      "type": "array"
    },
    "runtime": {
      "additionalProperties": true,
      "title": "Runtime",
      "type": "object"
    },
    "usage": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Usage"
    },
    "redactions": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Redactions",
      "type": "array"
    },
    "prev_event_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prev Event Hash"
    },
    "event_hash": {
      "title": "Event Hash",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "run_id",
    "review_id",
    "seq",
    "span_id",
