        "kind": {
          "enum": [
            "graph_node",
            "agent",
            "subagent",
            "tool",
            "memory",
            "sandbox",
            "harness",
            "governance",
            "evaluator",
            "runtime",
            "router",
            "data"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ],
